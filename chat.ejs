//const chatBox = document.getElementById('chatBox');

// Prevent swipe-to-reload when dragging the chatbox
document.addEventListener('touchmove', function(event) {
    if (isDragging || event.target.closest('#chatHeader')) {
        event.preventDefault(); // Prevent swipe-to-reload when dragging
    }
}, { passive: false });






