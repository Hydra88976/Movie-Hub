      /*padding: 10px;*/
      /*background: #222;*/
      padding-left: 5px;
      padding-right: 5px;
      padding-top: 5px;
      padding-bottom: 5px;
      position: fixed;
      bottom: 0px;
      left: 0;
      width: 100%;
      box-sizing: border-box;
      z-index: 999;
      height: 2.7rem;
      overflow: hidden;
      
