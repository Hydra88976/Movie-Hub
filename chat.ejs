// Start the loop
//requestAnimationFrame(sendSeekPosition);



//setInterval(sendSeekPosition, 100);




let lastSeekPosition = 0;
let seekTimeout = null;
const SEEK_THRESHOLD = 1; // in seconds
const SEEK_BUFFER_TIME = 2000; // in milliseconds, the buffer time between seeks
//const vid = document.getElementById('videoPlayer');

function handleSeek(currentTime) {
    if (Math.abs(currentTime - lastSeekPosition) > SEEK_THRESHOLD) {
        // Clear any previous seekTimeout, to avoid multiple seek events within short times
        if (seekTimeout) {
            clearTimeout(seekTimeout);
        }

        // Set a new timeout to emit the seek event after the buffer time
        seekTimeout = setTimeout(() => {
            socket.emit('seekPosition', currentTime);
            lastSeekPosition = currentTime;
            //requestAnimationFrame(handleSeek, vid.currentTime);
        }, SEEK_BUFFER_TIME);
    }
}

//requestAnimationFrame(handleSeek, vid.currentTime);

const videoElement = document.getElementById('videoPlayer');
videoElement.addEventListener('timeupdate', () => {
    handleSeek(videoElement.currentTime);  // Call handleSeek with the current playback time
      //socket.emit('seekPosition', videoElement.currentTime);
});

// In case the user manually drags the seekbar, trigger data send right away
videoElement.addEventListener('seeked', () => {
    socket.emit('seekPosition', videoElement.currentTime);
      //handleSeek(videoElement.currentTime);
    lastSeekPosition = videoElement.currentTime;
});

