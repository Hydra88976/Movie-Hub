<body>

  <!--  <h1>Video Player Admin</h1> -->

    <!-- Form to input video URL -->
    <form action="/submit" method="POST">
        <input type="text" class="url" name="videoUrl" placeholder="Enter video URL" required>
        <button type="submit" class="submit">OK</button>
    </form>

      <% if (videoUrl) { %>
        <video id="videoPlayer" controls>
            <!--<source src="<%= videoUrl %>" type="video/mp4">-->
             <source src="<%= videoUrl %>" type="application/x-mpegURL">
            Your browser does not support the video tag.
        </video>
    <% } else { %>
        <p>No video selected.</p>
    <% } %>

    <!-- Control Buttons for Admin -->
    <div class="control-buttons">
        <button id="playBtn" class="play">Play</button>
        <button id="pauseBtn" class="pause">Pause</button>
        <!--<button id="seekBtn" class="seek">Seek to 10s</button>-->
        <!-- Slider to control video seeking -->
        <input type="range"class="seek" id="seekSlider" min="0" value="0" step="1" />

    </div>

   <!-- Chat icon -->
    <!--<div id="chatIcon" class="chat-icon">💬</div>-->

    <!-- Chat box popup -->
    <div class="chat-container" id="chatBox">
        <div class="chat-header" id="chatHeader">Chat</div>
        <div class="message-box" id="messageBox"></div>
    </div>
    
    <div class="input-container">
            <input type="text" id="chatInput" style="font-size: 13px"; class="chat-input" placeholder="Type a message">
            <button id="sendBtn" class="send-btn">💬</button>
    </div>


    <!-- Add socket.io client script -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script>

        let MyName = "Aman";


        const socket = io();

        // Play the video when the "play" command is received
        socket.on('play', () => {
            const videoPlayer = document.getElementById('videoPlayer');
            if (videoPlayer) {
                videoPlayer.play();
            }
        });

        // Pause the video when the "pause" command is received
        socket.on('pause', () => {
            const videoPlayer = document.getElementById('videoPlayer');
            if (videoPlayer) {
                videoPlayer.pause();
            }
        });

        // Seek the video when the "seek" command is received
        socket.on('seek', (time) => {
            const videoPlayer = document.getElementById('videoPlayer');
            if (videoPlayer) {
                //videoPlayer.currentTime = time;
            }
        });


	// Get the video element and the slider
        const videoPlayer = document.getElementById('videoPlayer');
        const seekSlider = document.getElementById('seekSlider');

	// Sync the slider with the video player's current time
	videoPlayer.addEventListener('timeupdate', () => {
        seekSlider.value = videoPlayer.currentTime;
        seekSlider.max = videoPlayer.duration;  // Update the max value when the video duration changes
        });

	// Listen for the slider change and emit the 'seek' event with the new time
	seekSlider.addEventListener('input', () => {
        videoPlayer.currentTime = seekSlider.value;
        socket.emit('seek', seekSlider.value); // Emit the time when the slider changes
	});



        // Admin control buttons
        document.getElementById('playBtn').addEventListener('click', () => {
            socket.emit('play');
        });

        document.getElementById('pauseBtn').addEventListener('click', () => {
            socket.emit('pause');
        });

       /* document.getElementById('seekBtn').addEventListener('click', () => {
            socket.emit('seek', 10); // Seek to 10 seconds (for example)
        });*/

        // Chat functionality
        document.getElementById('sendBtn').addEventListener('click', () => {
            const chatInput = document.getElementById('chatInput');
            const message = chatInput.value.trim();

            const messageBox = document.getElementById('messageBox');
            const newMessage = document.createElement('div');
            newMessage.setAttribute("class","message-container");

            if (message) {
                // Emit the message to the server
                socket.emit('message', message, MyName);
                newMessage.textContent = message;
                /*messageBox.appendChild(newMessage);*/
                messageBox.scrollTop = messageBox.scrollHeight; // Auto scroll to the bottom
                // Clear the input field
                chatInput.value = '';
            }
        });

        // Listen for incoming chat messages
        socket.on('rmessage', (message, name) => {
            //alert(name);
            const messageBox = document.getElementById('messageBox');
            const newMessage = document.createElement('div');
            newMessage.setAttribute("class","message-container");
            //newMessage.textContent = message;
            newMessage.innerHTML+=`<div class="message-container">
                                        <!--<p class="uname">${name}:</p>-->
                                        <p class="umsg"><strong class="nm" style="color: ${name === MyName ? 'green' : 'orange'}">${name}:</strong> ${message}</p>
                                   </div>`;

            messageBox.appendChild(newMessage);
            messageBox.scrollTop = messageBox.scrollHeight; // Auto scroll to the bottom
        });



	// Open chat box when icon is clicked
document.getElementById('chatIcon').addEventListener('click', function() {
    document.getElementById('chatBox').style.display = 'block';
});

// Close chat box when close button is clicked
document.getElementById('closeBtn').addEventListener('click', function() {
    document.getElementById('chatBox').style.display = 'none';
});

// Make chat box draggable (works for both mouse and touch events)
const chatBox = document.getElementById('chatBox');
const chatHeader = document.getElementById('chatHeader');
let isDragging = false;
let offsetX, offsetY;

const startDrag = (e) => {

    isDragging = true;
    if (e.type === "mousedown") {
        offsetX = e.clientX - chatBox.getBoundingClientRect().left;
        offsetY = e.clientY - chatBox.getBoundingClientRect().top;
    } else if (e.type === "touchstart") {
        offsetX = e.touches[0].clientX - chatBox.getBoundingClientRect().left;
        offsetY = e.touches[0].clientY - chatBox.getBoundingClientRect().top;
    }
};

const dragMove = (e) => {
    if (isDragging) {
        let x, y;
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;
        const chatBoxWidth = chatBox.offsetWidth;
        const chatBoxHeight = chatBox.offsetHeight;

        // Calculate the new position
        if (e.type === "mousemove") {
            x = e.clientX - offsetX;
            y = e.clientY - offsetY;
        } else if (e.type === "touchmove") {
            x = e.touches[0].clientX - offsetX;
            y = e.touches[0].clientY - offsetY;
        }

        // Restrict the chat box within the bounds of the viewport
        x = Math.max(0, Math.min(x, viewportWidth - chatBoxWidth)); // Horizontal bounds
        y = Math.max(0, Math.min(y, viewportHeight - chatBoxHeight)); // Vertical bounds

        // Set the new position of the chat box
        chatBox.style.left = `${x}px`;
        chatBox.style.top = `${y}px`;
    }
};

const stopDrag = () => {

    isDragging = false;
};

// Add event listeners for mouse and touch events
chatHeader.addEventListener('mousedown', startDrag);
chatHeader.addEventListener('touchstart', startDrag);

document.addEventListener('mousemove', dragMove);
document.addEventListener('touchmove', dragMove);

document.addEventListener('mouseup', stopDrag);
document.addEventListener('touchend', stopDrag);
