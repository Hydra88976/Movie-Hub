        /* Chat icon */
.chat-icon {
    position: fixed;
    bottom: 20px;
    right: 20px;
    font-size: 30px;
    cursor: pointer;
}

/* Chat box styles */
    .chat-container {
      flex-direction: column;
      /*backdrop-filter: blur(10px);*/
      border-top: 0.5px solid grey;
      /*background-color: rgba(0, 0, 0, 0.2);*/
      overflow: hidden;
      position: relative;
      top: -5px;
      height: calc(100% - 18rem - 2.6rem);
      
    }

    .chat-header {
      padding: 5px;
      color: white;
      font-size: 10px;
      background-color: rgba(0,0,0,0.5);
      user-select: none;
      flex-shrink: 0;
    }

    .message-box {
      text-align: left;
      overflow-y: auto;
      padding: 5px;
      height: calc(100% - 1.8rem);
      backdrop-filter: blur(10px);
      background-color: rgba(0, 0, 0, 0.2);
    }

    .input-container {
