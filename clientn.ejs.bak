<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1 interactive-widget=resizes-content"/>
  <title>Video Player Admin</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100dvh; /* fixes virtual keyboard shrink issue */
      font-family: Arial, sans-serif;
      background-image: url("https://i.pinimg.com/originals/21/4e/fc/214efc2ae5ac3e094a716951f280ab7e.jpg");
      background-size: cover;
      background-repeat: no-repeat;
      overflow: hidden;
      text-align: center;
    }

    .app-container {
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    #videoPlayer {
      width: 100%;
      /*height: 35vh;*/
      height: 13rem;
      object-fit: cover;
      flex-shrink: 0;
    }

    .chat-container {
      flex-direction: column;
      backdrop-filter: blur(10px);
      border-top: 0.5px solid grey;
      background-color: rgba(0, 0, 0, 0.2);
      overflow: hidden;
      position: relative;
      height: calc(100% - 13rem - 2.9rem);
    }

    .chat-header {
      padding: 5px;
      color: white;
      font-size: 10px;
      background-color: rgba(0,0,0,0.5);
      user-select: none;
      flex-shrink: 0;
    }

    .message-box {
      text-align: left;
      overflow-y: auto;
      padding: 5px;
      height: calc(100% - 2rem);
      
    }

    .input-container {
      display: flex;
      /*padding: 10px;*/
      /*background: #222;*/
      padding-left: 5px;
      padding-right: 5px;
      padding-top: 5px;
      padding-bottom: 5px;
      position: fixed;
      bottom: 0px;
      left: 0;
      width: 100%;
      box-sizing: border-box;
      z-index: 999;
      height: 2.7rem;
      overflow: hidden;
      
      backdrop-filter: blur(10px);
      background-color: rgba(0, 0, 0, 0.2);
      border-top: 0.1px solid grey;
    }

    .chat-input {
      flex: 1;
      padding: 10px;
      font-size: 14px;
      border: none;
      border-radius: 5px;
      outline: none;
      background-color: #111;
      color: white;
      position: relative;
      bottom: 2px;
    }

    .send-btn {
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 5px;
      padding: 10px 15px;
      margin-left: 10px;
      cursor: pointer;
      position: relative;
      bottom: 3px;
    }

    .message-container {
      display: flex;
      align-items: center;
      margin-bottom: 5px;
      font-size: 13px;
    }

    .umsg {
     margin: 0; /* Remove default margins from paragraph */
    word-break: break-all;
    /*background-color: red;*/
    max-height: 100%;
    flex-basis: 100%;
    overflow: hidden;
    white-space: normal;
    text-indent: 0px;
    color: white;
    filter: contrast(150%);
    filter: brightness(150%);
    
      
    }

    .nm {
      font-weight: bold;
      /*margin-right: 5px;*/
      filter: contrast(150%);
      filter: brightness(150%);
    }

    @media (max-width: 600px) {
      .input-container {
        padding-bottom: env(safe-area-inset-bottom); /* for iOS notch support */
      }
    }
  </style>
</head>
<body>

  <!--<div class="app-container">-->
    <video id="videoPlayer" controls>
      <source id="videoSource" type="application/x-mpegURL">
      Your browser does not support the video tag.
    </video>

    <div class="chat-container" id="chatBox">
      <div class="chat-header">Chat</div>
      <div class="message-box" id="messageBox">   
      </div>
    </div>
  <!--</div>-->
  

  <!-- Fixed Input -->
  <div class="input-container">
    <input type="text" id="chatInput" class="chat-input" placeholder="Type your message"/>
    <button id="sendBtn" class="send-btn">💬</button>
  </div>

  <!-- Scripts -->
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <script>
    const socket = io();
    let MyName = prompt("Enter your name for chat:") || "Guest";

    socket.on('videoUrl', (videoUrl) => {
      const videoSource = document.getElementById('videoSource');
      const videoPlayer = document.getElementById('videoPlayer');
      videoSource.src = videoUrl;
      videoPlayer.load();
    });

    socket.on('play', () => document.getElementById('videoPlayer').play());
    socket.on('pause', () => document.getElementById('videoPlayer').pause());
    socket.on('seek', (time) => {
      document.getElementById('videoPlayer').currentTime = time;
    });

    document.getElementById('sendBtn').addEventListener('click', () => {
      const chatInput = document.getElementById('chatInput');
      const message = chatInput.value.trim();
      if (message) {
        socket.emit('message', message, MyName);
        chatInput.value = '';
      }
    });

    socket.on('rmessage', (message, name) => {
      const messageBox = document.getElementById('messageBox');
      const newMessage = document.createElement('div');
      newMessage.classList.add('message-container');
      newMessage.innerHTML = `<p class="umsg"><span class="nm" style="color:${name === MyName ? 'green' : 'orange'}">${name}:</span> ${message}</p>`;
      messageBox.appendChild(newMessage);
      messageBox.scrollTop = messageBox.scrollHeight;
    });
  </script>
</body>
</html>
